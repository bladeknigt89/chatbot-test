APP_NAME=Local AI Chatbot
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_PUBLIC_URL=http://localhost:8000
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720

DATABASE_URL=sqlite:///./storage/app.db

LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:7b
LLM_TEMPERATURE=0.1
LLM_SKIP_CHECK=false

EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BASE_URL=http://127.0.0.1:11434

VECTOR_DB_PATH=./storage/vector/vector.db
STORAGE_PATH=./storage/uploads
LOG_PATH=./storage/logs

MAX_FILE_SIZE=524288000
CHUNK_SIZE=500
CHUNK_OVERLAP=120
TOP_K=8

CHAT_HISTORY_ENABLED=true
OCR_ENABLED=false

LOGIN_RATE_LIMIT=5/minute
CHAT_RATE_LIMIT=30/minute
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000,null

ADMIN_USERNAME=ai
ADMIN_PASSWORD=No_comment_123
